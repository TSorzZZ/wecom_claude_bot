# ── Anthropic ──────────────────────────────────────────────────────────────
# 腾讯内网（codebuddy）部署：token 由 claude-internal 运行时自动注入，留空即可
# 标准 Anthropic 部署：填入 sk-ant-xxx 格式的 API Key
ANTHROPIC_API_KEY=
# 腾讯内网代理地址（codebuddy 部署时填写，公网部署留空）
ANTHROPIC_BASE_URL=

# 模型（默认 claude-sonnet-4-6）
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
SYSTEM_PROMPT=你是一个企业内部的 AI 助手，请用简洁、专业的中文回答用户问题。

# 每个用户保留的最近对话轮数（1轮 = 1问1答）
CONVERSATION_MAX_PAIRS=10

# ── 企业微信智能机器人（长连接模式）──────────────────────────────────────────
# 在「创建智能机器人 → API配置 → 使用长连接」页面查看
WECOM_BOT_ID=your_bot_id_here
WECOM_SECRET=your_secret_here

# ── Claude Agent SDK（Claude Code 工具集成）──────────────────────────────────
# Agent 的工作目录，文件操作将在此目录下进行
# Windows 示例：F:/workspace
# Linux 示例：/data/home/yourname/project/workspace
AGENT_CWD=/path/to/your/workspace
# 允许使用的工具列表（逗号分隔）
AGENT_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch
# 可选：指定 claude CLI 路径（留空则自动检测，腾讯内网填 claude-internal 路径）
# 腾讯内网示例：/data/home/yourname/.nvm/versions/node/v22.22.0/bin/claude-internal
AGENT_CLI_PATH=
