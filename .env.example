# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型（默认 claude-opus-4-6）
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=2048
SYSTEM_PROMPT=你是一个企业内部的 AI 助手，请用简洁、专业的中文回答用户问题。

# 每个用户保留的最近对话轮数（1轮 = 1问1答）
CONVERSATION_MAX_PAIRS=10

# ── 企业微信智能机器人（长连接模式）──────────────────────────────────────────
# 在「创建智能机器人 → API配置 → 使用长连接」页面查看
WECOM_BOT_ID=aib-UV0ehMuL-yMyKzQPqLuKOwoLhNwK2Ro
WECOM_SECRET=your_secret_here

# ── Claude Agent SDK（Claude Code 工具集成）──────────────────────────────────
# Agent 的工作目录，文件操作将在此目录下进行
AGENT_CWD=F:/workspace
# 允许使用的工具列表（逗号分隔）
AGENT_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch
# 可选：强制指定 claude CLI 路径（留空则自动检测）
# AGENT_CLI_PATH=
